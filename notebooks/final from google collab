        "from sklearn.preprocessing import StandardScaler, OneHotEncoder\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "# Подготовка признаков и целевой переменной\n",
        "# ВАЖНО: Удаляем DeltaForeign, чтобы избежать утечки данных!\n",
        "X = df.drop(columns=['HighOwnershipVolatility', 'Year', 'Company', 'DeltaForeign'])\n",
        "y = df['HighOwnershipVolatility']\n",
        "\n",
        "print('Признаки для обучения:', list(X.columns))\n",
        "print('\\nРаспределение целевой переменной y:')\n",
        "print(y.value_counts())\n",
        "\n",
        "# Предобработка: масштабирование числовых + кодирование категориальных\n",
        "preprocessor = ColumnTransformer(\n",
        "    transformers=[\n",
        "        ('num', StandardScaler(), ['ForeignShare', 'RussianShare']),\n",
        "        ('cat', OneHotEncoder(drop='first', sparse_output=False), ['Sector'])\n",
        "    ]\n",
        ")\n",
        "\n",
        "X_proc = preprocessor.fit_transform(X)\n",
        "\n",
        "# Разделение на train/test (75%/25%)\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X_proc, y, test_size=0.25, random_state=42, stratify=y\n",
        ")\n",
        "\n",
        "print('\\nРазмер Train выборки:', X_train.shape[0])\n",
        "print('Размер Test выборки:', X_test.shape[0])\n",
        "print('\\nДоля класса 1 в Train:', round(y_train.mean()*100, 1), '%')\n",
        "print('Доля класса 1 в Test:', round(y_test.mean()*100, 1), '%')"
      ]
    },
